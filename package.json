{
  "name": "nomikai-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "room:impression:check": "node scripts/impression-v2-check.mjs",
    "room:party-pack:check": "node scripts/party-pack-room-check.mjs",
    "room:johari:check": "node scripts/johari-room-check.mjs",
    "room:majority:check": "node scripts/majority-room-check.mjs",
    "room:large-majority:check": "node scripts/majority-room-check.mjs",
    "room:shared-majority:check": "node scripts/shared-majority-check.mjs",
    "room:shared-catalog:check": "node scripts/shared-catalog-check.mjs",
    "room:anonymous:check": "node scripts/anonymous-room-check.mjs",
    "room:lifecycle:check": "node scripts/room-lifecycle-check.mjs",
    "room:lifecycle:check:all": "node scripts/room-lifecycle-check-all.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
